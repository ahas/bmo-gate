[Unit]
Description=The Laya service's MCP and OpenAI-compatible front (docs/llm-server.md in the gate's repository)
After=bmo-llm-laya.service
Wants=bmo-llm-laya.service

[Service]
Type=simple
WorkingDirectory=%h/bmo-llm
# LLM_KEY and LAYA_TOKEN come from here.
EnvironmentFile=%h/.config/bmo-llm/env
ExecStart=%h/bmo-llm/.venv/bin/python %h/bmo-llm/front.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
