# Hand-installed on the GPU node by the Laya installer, out of a release: the installer uploads the
# front's files and installs this unit there. It stands outside the deployment's units glob and carries
# no deploy mark, so no deployment of this repository links or restarts it (docs/llm-server.md,
# 「Installing and updating」).
[Unit]
Description=The Laya service's MCP and OpenAI-compatible front (docs/llm-server.md in the gate's repository)
After=bmo-llm-laya.service
Wants=bmo-llm-laya.service

[Service]
Type=simple
WorkingDirectory=%h/bmo-llm
# LLM_KEY and LAYA_TOKEN come from here.
EnvironmentFile=%h/.config/bmo-llm/env
ExecStart=%h/bmo-llm/.venv/bin/python %h/bmo-llm/front.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
