[Unit]
Description={{label}}, served by llama.cpp on this node's card (the registration {{registration}} behind agency's gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/{{folder}}
# The model file and its served name come from here (MODEL_FILE, MODEL_NAME).
EnvironmentFile=%h/{{config}}/engine.env
# The slots, the store they share and its type, and the engine's own sampling defaults are the
# registration's in the installer's settings (docs/gguf-llm.md in the gate's repository); every other
# sampling setting is the caller's.
ExecStart=%h/{{llama_server}} \
  --model %h/{{folder}}/models/${MODEL_FILE} --alias ${MODEL_NAME} \
  --host 127.0.0.1 --port {{port}} --api-key-file %h/{{config}}/key \
  --n-gpu-layers {{gpu_layers}} --ctx-size {{context}} --parallel {{parallel}}{{slot_context}} \
  --flash-attn {{flash_attn}} --cache-type-k {{cache_type}} --cache-type-v {{cache_type}} \
  {{flags}}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
