[Unit]
Description=Laya decision server (docs/laya-server.md in the bmo-gate repository)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/bmo-laya
Environment=USE_TF=0
Environment=LAYA_PORT=7431
Environment=LAYA_TOKEN_FILE=%h/.config/bmo-laya/token
EnvironmentFile=-%h/.config/bmo-laya/env
ExecStart=%h/bmo-laya/.venv/bin/python %h/bmo-laya/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
