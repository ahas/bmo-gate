  // and server configs; the tests under tests/client are a project of their own beside them.
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" },
    { "path": "./host" },
    { "path": "./host/tsconfig.server.json" },
    { "path": "../tests/client" }
  ]
}
