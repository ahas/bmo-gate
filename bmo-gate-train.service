[Unit]
Description=bmo-gate-train — 판정 회차의 게이트를 자란 만큼 학습하고 점수 곡선을 남기는 한 회차
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/repos/ahas/bmo-gate
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One pass over the judging run: every gate cut at its whole batches, the ones with a quarter new rows
# since their last point trained on n2 to n5, and a point a gate appended to the curve. A pass with
# nothing to train reads the batches and ends; the timer never starts a second one while this one is
# still going (docs/training.md 「A pass」).
ExecStart=%h/.bun/bin/bun scripts/laya-train.ts judging:real-1
TimeoutStartSec=infinity
