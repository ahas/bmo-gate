[Unit]
Description=A retired unit, taken out by the deployment that stopped, disabled and unlinked it (docs/layout.md)

[Service]
Type=oneshot
ExecStart=/bin/true

[Install]
WantedBy=default.target
# Retired: the deployment stops, disables and unlinks it once the service is up, and a later commit
# removes this file.
X-BMO-Deploy=retire
