[Unit]
Description=bmo-gate-sanitizer: the sanitiser gate's rows, written on the local-model road
After=network-online.target
Wants=network-online.target
# The sanitiser gate alone, on the local-model road, because codex refuses its attack rows at the account
# level however the model is set. It runs beside the codex unit, which writes the other gates and is
# told to leave this gate alone; the gate is claimed while it is being written, so neither unit can
# write over what the other froze even if both were pointed at it.
# A network or service fault is transient and is resumed; a fault that cannot be written past fails
# the same way every try, so the unit gives up after a bounded number of tries in an hour.
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/bmo-gate/deploy/training/tooling
Environment=BMO_DATA_DIR=%h/.local/share/bmo/data
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Always resumed, never overwritten: the batches frozen on the codex stretch stand, and every
# restart takes up at the batch after the last one frozen on either road. An overwrite here would
# throw away both the codex rows and whatever the local model has written since.
ExecStart=%h/.bun/bin/bun scripts/laya-synth.ts --run full-1 --gate sanitizer --road local --rows 9000 --batch 20 --resume
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
# Started by hand, never by the deployment, which links it and nothing more.
X-BMO-Deploy=link
