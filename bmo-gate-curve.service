[Unit]
Description=bmo-gate-curve — 판정 중인 게이트를 쌓인 만큼 잘라 학습하고 점수 곡선을 남기는 한 회차
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/repos/ahas/bmo-gate
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One pass: every gate cut at its whole batches, the ones grown a quarter since their last point
# trained on n2 to n5, and a point a gate appended to the curve. A pass with nothing grown enough
# reads the batches and ends. A pass is at most a few gates' training, so it has no start timeout;
# the timer never starts a second one while this one is still going.
ExecStart=%h/.bun/bin/bun scripts/laya-curve.ts real-1
TimeoutStartSec=infinity
