[Unit]
Description=The house LLM service's vLLM (docs/llm-server.md in the bmo-gate repository)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/bmo-llm
# VLLM_API_KEY and HF_HOME come from here; the key is never on the command line.
EnvironmentFile=%h/.config/bmo-llm/env
# The model is downloaded by the setup, so a start never waits on the hub.
Environment=HF_HUB_OFFLINE=1
Environment=VLLM_NO_USAGE_STATS=1
# Sampling runs on vLLM's own PyTorch sampler: FlashInfer's is built on first use with the node's
# toolchain, which a start must never depend on.
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
Environment=PATH=%h/bmo-llm/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/bmo-llm/.venv/bin/vllm serve RedHatAI/Qwen3.5-4B-quantized.w4a16 --served-model-name qwen3.5-4b --host 127.0.0.1 --port 8000 --max-model-len 32768 --max-num-seqs 3 --max-num-batched-tokens 8192 --gpu-memory-utilization 0.85 --language-model-only --reasoning-parser qwen3
TimeoutStartSec=15min
TimeoutStopSec=60
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
