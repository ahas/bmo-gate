diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index d398ee1..303462c 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2608,6 +2608,67 @@ ggml_tensor * llm_graph_context::build_pos_bias(ggml_tensor * pos_bucket, ggml_t
     return pos_bias;
 }
 
+// Where the attention over a KV store kept in host memory (--no-kv-offload) is run. A batch of any size, a
+// prompt's or an answer's, over a store of at least LLAMA_NKVO_ATTN_MIN_KV cells (0 unless set: the device
+// is no slower over the shortest store and far faster over a long one) is left to the scheduler, which
+// copies each layer's store into the device's compute buffer, turns it into the f16 the device's flash
+// attention reads, and runs the attention there, reusing that room for the next layer. It goes there only
+// while the device has the room: what the store's copy, its f16 form and the mask add to the room the
+// scheduler's compute buffer already holds must fit what the device has free, less
+// LLAMA_NKVO_ATTN_KEEP_MIB (64 unless set) kept for its own buffers. A graph whose buffer the device still
+// refuses is built again with that store's attention on the CPU, and so is every longer store from then
+// on. A store the device has no room for is run on the CPU where it lies.
+static int64_t llm_nkvo_attn_ceiling = INT64_MAX; // stores longer than this are run on the CPU
+static int64_t llm_nkvo_attn_last    = 0;         // the store the last graph ran on the device, 0 for none
+static std::map<ggml_backend_sched_t, int64_t> llm_nkvo_attn_held; // the room each scheduler's buffer grew to
+
+static bool llm_nkvo_attn_on_device(ggml_backend_sched_t sched, const ggml_tensor * k, const ggml_tensor * v,
+                                    const ggml_tensor * mask) {
+    static const int64_t min_kv = getenv("LLAMA_NKVO_ATTN_MIN_KV") ? atoll(getenv("LLAMA_NKVO_ATTN_MIN_KV")) : 0;
+    static const int64_t keep   = (getenv("LLAMA_NKVO_ATTN_KEEP_MIB") ? atoll(getenv("LLAMA_NKVO_ATTN_KEEP_MIB")) : 64) << 20;
+
+    const int64_t n_kv = k->ne[1];
+    if (n_kv < min_kv || n_kv > llm_nkvo_attn_ceiling) {
+        return false;
+    }
+
+    ggml_backend_t device = nullptr;
+    for (int i = 0; i < ggml_backend_sched_get_n_backends(sched) && device == nullptr; ++i) {
+        ggml_backend_t b = ggml_backend_sched_get_backend(sched, i);
+        if (ggml_backend_dev_type(ggml_backend_get_device(b)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            device = b;
+        }
+    }
+    if (device == nullptr) {
+        return false;
+    }
+
+    size_t free = 0;
+    size_t total = 0;
+    ggml_backend_dev_memory(ggml_backend_get_device(device), &free, &total);
+
+    const int64_t need = ggml_nbytes(k) + ggml_nbytes(v) + (mask ? ggml_nbytes(mask) : 0) +
+        (k->type != GGML_TYPE_F16 ? ggml_nelements(k)*ggml_type_size(GGML_TYPE_F16) : 0) +
+        (v->type != GGML_TYPE_F16 ? ggml_nelements(v)*ggml_type_size(GGML_TYPE_F16) : 0);
+    int64_t & held = llm_nkvo_attn_held[sched];
+
+    if (need - held > (int64_t) free - keep) {
+        return false;
+    }
+    held = std::max(held, need);
+    llm_nkvo_attn_last = n_kv;
+    return true;
+}
+
+bool llm_nkvo_attn_fall_back() {
+    if (llm_nkvo_attn_last == 0) {
+        return false;
+    }
+    llm_nkvo_attn_ceiling = llm_nkvo_attn_last - 1;
+    llm_nkvo_attn_last = 0;
+    return true;
+}
+
 ggml_tensor * llm_graph_context::build_attn_mha(
          ggml_tensor * q,
          ggml_tensor * k,
@@ -2656,6 +2717,11 @@ ggml_tensor * llm_graph_context::build_attn_mha(
                                   hparams.attn_soft_cap ? hparams.f_attn_logit_softcapping : 0.0f);
         res->add_fused_node({LLM_FUSED_OP_FLASH_ATTN, cur, il});
 
+        if (!cparams.offload_kqv && !llm_nkvo_attn_on_device(sched, k, v, kq_mask)) {
+            // the KV store is in host memory, and this attention over it is run on the CPU where it lies
+            ggml_backend_sched_set_tensor_backend(sched, cur, backend_cpu);
+        }
+
         ggml_flash_attn_ext_add_sinks(cur, sinks);
         GGML_ASSERT(n_kv_max >= 0 && n_kv_max <= INT32_MAX);
         ggml_flash_attn_ext_set_n_kv_max(cur, static_cast<int32_t>(n_kv_max));
