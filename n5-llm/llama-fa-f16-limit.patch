+// The longest KV store whose attention is computed by a kernel that reads the store in f16
+// (GGML_CUDA_FA_F16_MAX_KV, cells; unset or 0 for no limit). A quantized store that such a kernel
+// reads is first copied whole into f16 in the compute buffer, which a long context cannot spare on
+// every card, so a batch over a longer quantized store goes to the vector kernel, which reads the
+// quantized store where it lies.
+static int64_t ggml_cuda_fattn_f16_max_kv() {
+    static const int64_t max_kv = [] {
+        const char * text = getenv("GGML_CUDA_FA_F16_MAX_KV");
+        return text != nullptr ? (int64_t) atoll(text) : (int64_t) 0;
+    }();
+    return max_kv;
+}
+
+static bool ggml_cuda_fattn_past_f16_max_kv(const ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const int64_t max_kv = ggml_cuda_fattn_f16_max_kv();
+    return max_kv > 0 && K->ne[1] > max_kv && (ggml_is_quantized(K->type) || ggml_is_quantized(V->type)) &&
+        Q->ne[0] <= 256 && Q->ne[0] % 64 == 0 && Q->ne[0] != 192 && K->ne[1] % FATTN_KQ_STRIDE == 0 &&
+        ggml_cuda_get_fattn_vec_case(Q->ne[0], K->type, V->type) != nullptr;
+}
+
 static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const ggml_tensor * dst) {
 #ifndef FLASH_ATTN_AVAILABLE
     GGML_UNUSED(device); GGML_UNUSED(dst);
@@ -630,6 +653,10 @@
         return BEST_FATTN_KERNEL_NONE;
     }
 
+    if (ggml_cuda_fattn_past_f16_max_kv(dst)) {
+        return BEST_FATTN_KERNEL_VEC;
+    }
+
     // For small batch sizes the vector kernel may be preferable over the kernels optimized for large batch sizes:
     // 192 satisfies % 64 == 0 but has no vec instance (DKQ != DV); force it onto the MMA path.
     const bool can_use_vector_kernel = Q->ne[0] <= 256 && Q->ne[0] % 64 == 0 && Q->ne[0] != 192 && K->ne[1] % FATTN_KQ_STRIDE == 0;
@@ -731,6 +758,17 @@
 
     const best_fattn_kernel kernel = ggml_cuda_get_best_fattn_kernel(device, dst);
 
+    // A store past the limit is read by the vector kernel, but the graph reserved for the longest store
+    // has to leave room for the f16 copy a store at the limit takes, since a shorter store goes to the
+    // kernel that reads f16 and the room is not reserved again for it.
+    if (ggml_cuda_fattn_past_f16_max_kv(dst)) {
+        const int64_t max_kv = ggml_cuda_fattn_f16_max_kv();
+        size_t end = ggml_nbytes(dst);
+        end = GGML_PAD(end, 128) + 128 + (size_t) (ggml_nelements(K)/K->ne[1])*max_kv*ggml_type_size(GGML_TYPE_F16);
+        end = GGML_PAD(end, 128) + 128 + (size_t) (ggml_nelements(V)/V->ne[1])*max_kv*ggml_type_size(GGML_TYPE_F16);
+        return end;
+    }
+
     bool need_f16_K = false;
     bool need_f16_V = false;
 
