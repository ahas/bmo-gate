+// A sequence's state saved in pieces: a range of a tensor on an RPC buffer is written by its server
+// to that server's own disk, and the file keeps only the piece's name, its server and its size; every
+// other range is written into the file itself. Each range is tagged with which it is.
+struct llama_rpc_state_api {
+    bool (*save)(const ggml_tensor *, size_t, size_t, const char *) = nullptr;
+    bool (*load)(ggml_tensor *, size_t, size_t, const char *) = nullptr;
+    bool (*finish)() = nullptr;
+    const char * (*endpoint)(const ggml_tensor *) = nullptr;
+};
+
+static const llama_rpc_state_api & llama_rpc_state() {
+    static const llama_rpc_state_api api = [] {
+        llama_rpc_state_api found;
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("RPC");
+        if (reg != nullptr) {
+            found.save     = (decltype(found.save))     ggml_backend_reg_get_proc_address(reg, "ggml_backend_rpc_tensor_state_save");
+            found.load     = (decltype(found.load))     ggml_backend_reg_get_proc_address(reg, "ggml_backend_rpc_tensor_state_load");
+            found.finish   = (decltype(found.finish))   ggml_backend_reg_get_proc_address(reg, "ggml_backend_rpc_state_finish");
+            found.endpoint = (decltype(found.endpoint)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_rpc_tensor_endpoint");
+        }
+        if (found.save == nullptr || found.load == nullptr || found.finish == nullptr || found.endpoint == nullptr) {
+            found = llama_rpc_state_api();
+        }
+        return found;
+    }();
+    return api;
+}
+
+static const uint8_t LLAMA_STATE_RANGE_INLINE = 0;
+static const uint8_t LLAMA_STATE_RANGE_PIECE  = 1;
+
+// Waits for every piece queued since the last call; true where there were none.
+static bool llama_rpc_state_finish() {
+    const auto & api = llama_rpc_state();
+    return api.finish == nullptr || api.finish();
+}
