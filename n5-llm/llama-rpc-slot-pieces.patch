+// Slot state kept where it lies: a save or a load of a tensor range on an RPC buffer is queued to that
+// buffer's server and runs there, every server at once, until ggml_backend_rpc_state_finish waits for
+// all of them and says whether each one did its part.
+struct rpc_state_pending {
+    std::shared_ptr<rpc_dispatcher>    dispatcher;
+    std::shared_ptr<rpc_msg_state_rsp> response;
+};
+
+static std::mutex rpc_state_mutex;
+static std::vector<rpc_state_pending> rpc_state_pendings;
+
+static bool ggml_backend_rpc_state_op(enum rpc_cmd cmd, const ggml_tensor * tensor, size_t offset, size_t size, const char * name) {
+    if (tensor == nullptr || tensor->buffer == nullptr || !ggml_backend_buffer_is_rpc(tensor->buffer) ||
+            name == nullptr || strlen(name) == 0 || strlen(name) >= sizeof(rpc_msg_state_req::name)) {
+        return false;
+    }
+    ggml_backend_rpc_buffer_context * ctx = (ggml_backend_rpc_buffer_context *)tensor->buffer->context;
+    auto request = std::make_shared<rpc_msg_state_req>();
+    memset(request.get(), 0, sizeof(*request));
+    request->tensor = serialize_tensor(tensor);
+    request->offset = offset;
+    request->size   = size;
+    snprintf(request->name, sizeof(request->name), "%s", name);
+    auto response = std::make_shared<rpc_msg_state_rsp>();
+    response->result = 0;
+    ctx->dispatcher->send_async(cmd, request, sizeof(*request), response.get(), sizeof(*response));
+    std::lock_guard<std::mutex> lock(rpc_state_mutex);
+    rpc_state_pendings.push_back({ctx->dispatcher, response});
+    return true;
+}
+
+extern "C" bool ggml_backend_rpc_tensor_state_save(const ggml_tensor * tensor, size_t offset, size_t size, const char * name) {
+    return ggml_backend_rpc_state_op(RPC_CMD_STATE_SAVE, tensor, offset, size, name);
+}
+
+extern "C" bool ggml_backend_rpc_tensor_state_load(ggml_tensor * tensor, size_t offset, size_t size, const char * name) {
+    return ggml_backend_rpc_state_op(RPC_CMD_STATE_LOAD, tensor, offset, size, name);
+}
+
+extern "C" bool ggml_backend_rpc_state_finish(void) {
+    std::vector<rpc_state_pending> pendings;
+    {
+        std::lock_guard<std::mutex> lock(rpc_state_mutex);
+        pendings.swap(rpc_state_pendings);
+    }
+    std::vector<std::shared_ptr<rpc_dispatcher>> waited;
+    bool ok = true;
+    for (const auto & pending : pendings) {
+        if (std::find(waited.begin(), waited.end(), pending.dispatcher) == waited.end()) {
+            pending.dispatcher->synchronize();
+            waited.push_back(pending.dispatcher);
+        }
+        ok = ok && pending.response->result == 1;
+    }
+    return ok;
+}
+
+// The server a tensor's buffer lives on, or NULL where it is not an RPC buffer.
+extern "C" const char * ggml_backend_rpc_tensor_endpoint(const ggml_tensor * tensor) {
+    if (tensor == nullptr || tensor->buffer == nullptr || !ggml_backend_buffer_is_rpc(tensor->buffer)) {
+        return nullptr;
+    }
+    ggml_backend_rpc_buffer_type_context * buft_ctx = (ggml_backend_rpc_buffer_type_context *)tensor->buffer->buft->context;
+    return buft_ctx->endpoint.c_str();
+}
