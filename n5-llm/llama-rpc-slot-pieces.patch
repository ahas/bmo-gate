+void rpc_server::state_op(bool save, const rpc_msg_state_req & request, rpc_msg_state_rsp & response) {
+    response.result = 0;
+    const char * dir = getenv("GGML_RPC_STATE_DIR");
+    const std::string name(request.name, strnlen(request.name, sizeof(request.name)));
+    if (dir == nullptr || name.empty() || name[0] == '.' || name.find('/') != std::string::npos) {
+        GGML_LOG_ERROR("[%s] no state folder, or a name that is not a plain file name\n", __func__);
+        return;
+    }
+    struct ggml_init_params params {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_tensor * tensor = deserialize_tensor(ctx_ptr.get(), &request.tensor);
+    if (tensor == nullptr || tensor->buffer == nullptr) {
+        GGML_LOG_ERROR("[%s] error deserializing tensor\n", __func__);
+        return;
+    }
+    {
+        const size_t p0 = (size_t) ggml_backend_buffer_get_base(tensor->buffer);
+        const size_t p1 = p0 + ggml_backend_buffer_get_size(tensor->buffer);
+        if (request.tensor.data + request.offset < p0 || request.tensor.data + request.offset >= p1 ||
+                request.size > (p1 - request.tensor.data - request.offset)) {
+            GGML_LOG_ERROR("[%s] tensor region out of buffer bounds\n", __func__);
+            return;
+        }
+    }
+    const fs::path path = fs::path(dir) / name;
+    const size_t chunk = 64u*1024*1024;
+    std::vector<uint8_t> data(std::min<size_t>(chunk, request.size));
+    if (save) {
+        const fs::path part = fs::path(dir) / (name + ".part");
+        FILE * f = fopen(part.c_str(), "wb");
+        if (f == nullptr) {
+            GGML_LOG_ERROR("[%s] cannot write %s\n", __func__, part.c_str());
+            return;
+        }
+        bool written = true;
+        for (size_t done = 0; done < request.size && written; done += chunk) {
+            const size_t n = std::min(chunk, (size_t) request.size - done);
+            ggml_backend_tensor_get(tensor, data.data(), request.offset + done, n);
+            written = fwrite(data.data(), 1, n, f) == n;
+        }
+        written = fclose(f) == 0 && written;
+        std::error_code ec;
+        if (!written || (fs::rename(part, path, ec), ec)) {
+            fs::remove(part, ec);
+            GGML_LOG_ERROR("[%s] writing %s failed\n", __func__, path.c_str());
+            return;
+        }
+    } else {
+        std::error_code ec;
+        const auto bytes = fs::file_size(path, ec);
+        if (ec || bytes != request.size) {
+            GGML_LOG_ERROR("[%s] %s is missing or not %" PRIu64 " bytes\n", __func__, path.c_str(), request.size);
+            return;
+        }
+        FILE * f = fopen(path.c_str(), "rb");
+        if (f == nullptr) {
+            return;
+        }
+        bool read = true;
+        for (size_t done = 0; done < request.size && read; done += chunk) {
+            const size_t n = std::min(chunk, (size_t) request.size - done);
+            read = fread(data.data(), 1, n, f) == n;
+            if (read) {
+                ggml_backend_tensor_set(tensor, data.data(), request.offset + done, n);
+            }
+        }
+        fclose(f);
+        if (!read) {
+            GGML_LOG_ERROR("[%s] reading %s failed\n", __func__, path.c_str());
+            return;
+        }
+    }
+    response.result = 1;
+}
